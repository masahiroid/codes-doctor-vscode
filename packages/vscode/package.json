{
  "name": "codes-doctor",
  "displayName": "Codes Doctor",
  "description": "%extension.description%",
  "version": "3.0.1",
  "publisher": "masahirocom",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/masahiroid/codes-doctor-vscode.git",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/masahiroid/codes-doctor-vscode/issues"
  },
  "homepage": "https://github.com/masahiroid/codes-doctor-vscode#readme",
  "keywords": [
    "code quality",
    "god class",
    "technical debt",
    "security",
    "static analysis",
    "dependency graph",
    "sbom"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeDoctor",
          "title": "Codes Doctor",
          "icon": "media/csap.svg"
        }
      ]
    },
    "views": {
      "codeDoctor": [
        {
          "id": "codeDoctor.actions",
          "name": "%view.dashboard%",
          "type": "webview",
          "icon": "media/csap.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "codeDoctor.analyzeCurrentWorkspace",
        "title": "%codeDoctor.analyzeCurrentWorkspace%"
      },
      {
        "command": "codeDoctor.setLlmApiKey",
        "title": "%codeDoctor.setLlmApiKey%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeDoctor.analyzeCurrentWorkspace",
          "when": "view == codeDoctor.actions",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Codes Doctor",
      "properties": {
        "codeDoctor.reportOpenMode": {
          "type": "string",
          "enum": [
            "external",
            "webview",
            "vscode"
          ],
          "default": "external",
          "description": "%config.reportOpenMode.description%",
          "enumDescriptions": [
            "%config.reportOpenMode.option.0%",
            "%config.reportOpenMode.option.1%",
            "%config.reportOpenMode.option.2%"
          ]
        },
        "codeDoctor.analysisLanguage": {
          "type": "string",
          "enum": [
            "auto",
            "typescript",
            "javascript",
            "php",
            "dart",
            "python",
            "go",
            "swift",
            "csharp",
            "java",
            "kotlin",
            "rust",
            "cpp"
          ],
          "default": "auto",
          "description": "%config.analysisLanguage.description%",
          "enumDescriptions": [
            "%config.analysisLanguage.option.0%",
            "%config.analysisLanguage.option.1%",
            "%config.analysisLanguage.option.2%",
            "%config.analysisLanguage.option.3%",
            "%config.analysisLanguage.option.4%",
            "%config.analysisLanguage.option.5%",
            "%config.analysisLanguage.option.6%",
            "%config.analysisLanguage.option.7%",
            "%config.analysisLanguage.option.8%",
            "%config.analysisLanguage.option.9%",
            "%config.analysisLanguage.option.10%",
            "%config.analysisLanguage.option.11%",
            "%config.analysisLanguage.option.12%"
          ]
        },
        "codeDoctor.llmProvider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic"
          ],
          "enumDescriptions": [
            "%config.llmProvider.option.0%",
            "%config.llmProvider.option.1%"
          ],
          "default": "openai",
          "description": "%config.llmProvider.description%"
        },
        "codeDoctor.llmOutputMode": {
          "type": "string",
          "enum": [
            "review",
            "agentPrompt"
          ],
          "enumDescriptions": [
            "%config.llmOutputMode.option.0%",
            "%config.llmOutputMode.option.1%"
          ],
          "default": "review",
          "description": "%config.llmOutputMode.description%"
        },
        "codeDoctor.llmModel": {
          "type": "string",
          "default": "",
          "description": "%config.llmModel.description%"
        },
        "codeDoctor.displayLanguage": {
          "type": "string",
          "scope": "application",
          "enum": [
            "en",
            "ja"
          ],
          "enumDescriptions": [
            "English",
            "日本語"
          ],
          "default": "en",
          "description": "%config.displayLanguage.description%"
        },
        "codeDoctor.llmMaxOutputTokens": {
          "type": "integer",
          "minimum": 200,
          "maximum": 1000000,
          "default": 16000,
          "description": "%config.llmMaxOutputTokens.description%"
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "lint": "npm run typecheck",
    "vendor:csap": "npm run build --prefix ../engine && node ../../scripts/vendor-engine.mjs .",
    "prepackage": "npm run vendor:csap && npm run build && npm run bundle",
    "package": "npx @vscode/vsce package --no-dependencies",
    "package:release": "npm run prepackage && mkdir -p releases && VERSION=$(node -p \"require('./package.json').version\") && npx @vscode/vsce package --no-dependencies -o releases/codes-doctor-$VERSION.vsix && cp releases/codes-doctor-$VERSION.vsix releases/codes-doctor-latest.vsix",
    "prepublish:marketplace": "npm run vendor:csap && npm run build && npm run bundle",
    "publish:marketplace": "npx @vscode/vsce publish --no-dependencies",
    "publish:patch": "npm run vendor:csap && npm run build && npm run bundle && npx @vscode/vsce publish --no-dependencies patch",
    "publish:minor": "npm run vendor:csap && npm run build && npm run bundle && npx @vscode/vsce publish --no-dependencies minor",
    "publish:major": "npm run vendor:csap && npm run build && npm run bundle && npx @vscode/vsce publish --no-dependencies major",
    "test": "npm run build && npm run bundle && node --test test/*.test.js",
    "build": "node node_modules/typescript-compiler/bin/tsc -p tsconfig.json",
    "typecheck": "node node_modules/typescript-compiler/bin/tsc -p tsconfig.json --noEmit",
    "test:browser": "npm run vendor:csap && npm run build && playwright test",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@typescript-eslint/typescript-estree": "^8.71.1",
    "php-parser": "^3.7.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript-compiler": "npm:typescript@^7.0.2"
  }
}

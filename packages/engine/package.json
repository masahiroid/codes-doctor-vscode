{
  "name": "@codes-doctor/engine",
  "version": "7.2.0",
  "private": true,
  "description": "Codes Doctor analysis engine: structural, security and dependency analysis with HTML reports",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "dist-en",
    "assets"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "node scripts/build-report-libraries.mjs && rm -rf dist && tsc -p tsconfig.json && node scripts/localize-en.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "benchmark:security": "npm run build && node scripts/benchmark-security.mjs"
  },
  "dependencies": {
    "@typescript-eslint/typescript-estree": "^8.71.2",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "php-parser": "^3.7.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "chart.js": "^4.6.1",
    "d3": "^7.9.0",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0"
  },
  "overrides": {
    "mermaid": {
      "katex": "0.19.0"
    }
  },
  "allowScripts": {
    "esbuild": false
  }
}

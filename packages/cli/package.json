{
  "name": "codes-doctor",
  "version": "6.0.4",
  "private": true,
  "description": "Codes Doctor command line: structural, security and dependency analysis with an HTML report",
  "license": "Apache-2.0",
  "bin": {
    "codes-doctor": "bin/codes-doctor.js"
  },
  "files": [
    "bin",
    "lib",
    "vendor"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vendor": "npm run build --prefix ../engine && node ../../scripts/vendor-engine.mjs .",
    "build": "npm run vendor && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@typescript-eslint/typescript-estree": "^8.71.2",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "php-parser": "^3.7.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4"
  }
}

# Server Configuration
PORT=3000
NODE_ENV=production

# LLM Configuration
CSAP_LLM_ENABLED=true
# provider: openai | anthropic
CSAP_LLM_PROVIDER=openai
# Model names change over time — call POST /api/llm/models with your provider
# and API key to get the live list your key can access, rather than guessing.
CSAP_LLM_MODEL=gpt-5.4
CSAP_LLM_AST_MODEL=gpt-5.3-chat
CSAP_LLM_MAX_TOKENS=3000
CSAP_LLM_AST_MAX_TOKENS=4000
CSAP_LLM_TEMPERATURE=0.2
OPENAI_API_KEY=sk-proj-xxx...
# ANTHROPIC_API_KEY=sk-ant-xxx... (only needed if CSAP_LLM_PROVIDER=anthropic)

# Feature Flags
CSAP_PHP_ENABLED=true

# Resource Limits
CSAP_MAX_FILE_SIZE=524288000

# Storage Paths (optional; default to <cwd>/uploads, <cwd>/temp, <cwd>/output)
# CSAP_UPLOADS_DIR=/path/to/uploads
# CSAP_TEMP_DIR=/path/to/temp
# CSAP_OUTPUT_DIR=/path/to/output
